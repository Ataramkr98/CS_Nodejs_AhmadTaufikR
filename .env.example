# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# Required: DATABASE_URL. Everything else has a working development default.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# --- database --------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cspintar?schema=public
# Used only by `prisma migrate deploy` at container start, so migrations never
# run against the runtime connection pool.
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cspintar?schema=public
DATABASE_POOL_SIZE=10

# --- auth ------------------------------------------------------------------
# RS256 PEM pair (private + public). Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -pubout -in private.pem -out public.pem
# Keys may also be base64-encoded into JWT_PRIVATE_KEY_B64 / JWT_PUBLIC_KEY_B64.
# Without a pair the API logs a warning and generates ephemeral keys, which
# invalidates every token on restart. Always set these in production.
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=

# Session lifetimes in seconds.
ACCESS_TTL=900
REFRESH_TTL=604800

# Cookie flags. Leave COOKIE_SECURE unset to follow NODE_ENV; set it explicitly
# to true behind TLS termination on a non-production environment.
COOKIE_SECURE=
COOKIE_SAMESITE=lax
# Set for a split-domain deployment (app.example.com + api.example.com). When
# the frontend is on a different site, use COOKIE_SAMESITE=none + secure=true.
COOKIE_DOMAIN=

# --- cors ------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# --- queue -----------------------------------------------------------------
# Set to true to use BullMQ. Requires REDIS_URL.
QUEUE_ENABLED=false
REDIS_URL=redis://localhost:6379

# --- providers -------------------------------------------------------------
# demo  : answer from retrieved knowledge-base chunks, no external calls
# live  : call the provider APIs below
AI_MODE=demo

# AUTOAPP_TOKEN=
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- rate limiting ---------------------------------------------------------
THROTTLE_LIMIT=300
THROTTLE_TTL=60000

# --- uploads ---------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=20971520